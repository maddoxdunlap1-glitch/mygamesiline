  // ----- Admin Brute-force -----
  async function bruteForceAdmin(adminUrls) {
    const credentials = [
      ['admin', 'admin'],
      ['admin', 'password'],
      ['admin', '123456'],
      ['admin', 'admin123'],
      ['root', 'root'],
      ['root', 'password'],
      ['user', 'user'],
      ['admin', 'letmein'],
      ['administrator', 'administrator'],
      ['admin', 'password123']
    ];
    for (const url of adminUrls) {
      try {
        const resp = await fetchUrl(url, 5000);
        const html = await resp.text();
        const doc = document.createElement('html');
        doc.innerHTML = html;
        const forms = doc.querySelectorAll('form');
        for (const form of forms) {
          const passwordInput = form.querySelector('input[type="password"]');
          if (!passwordInput) continue;
          const usernameInput = form.querySelector('input[name="username"], input[name="user"], input[name="login"], input[name="email"], input[name="uname"]');
          if (!usernameInput) continue;
          const action = form.getAttribute('action') || '';
          const method = (form.getAttribute('method') || 'get').toLowerCase();
          const usernameName = usernameInput.getAttribute('name') || 'username';
          const passwordName = passwordInput.getAttribute('name') || 'password';
          for (const [user, pass] of credentials) {
            const data = new URLSearchParams();
            data.set(usernameName, user);
            data.set(passwordName, pass);
            const fullAction = new URL(action, url).href;
            const options = {
              method: method.toUpperCase(),
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: data.toString(),
              credentials: 'omit',
              redirect: 'manual'
            };
            const loginResp = await fetch(fullAction, options);
            const location = loginResp.headers.get('location');
            const setCookie = loginResp.headers.get('set-cookie');
            if (loginResp.status === 302 || loginResp.status === 303 || loginResp.status === 301) {
              if (location && (location.includes('admin') || location.includes('dashboard') || location.includes('home'))) {
                results.adminBrute.push({ url, credentials: `${user}:${pass}`, success: true, redirect: location });
                return;
              }
            }
            if (setCookie && (setCookie.includes('session') || setCookie.includes('PHPSESSID'))) {
              results.adminBrute.push({ url, credentials: `${user}:${pass}`, success: true, note: 'session cookie set' });
              return;
            }
          }
        }
      } catch (_) {}
    }
  }

  // ----- File Upload Testing -----
  async function testFileUpload(baseUrl) {
    const uploadEndpoints = [
      '/upload', '/upload.php', '/wp-admin/media-upload.php',
      '/admin/upload', '/admin/upload.php', '/fileupload',
      '/index.php?upload', '/uploader', '/uploads'
    ];
    const testContent = 'VulnScannerTestFile';
    const testFileName = 'test.txt';
    const boundary = '----WebKitFormBoundary' + Math.random().toString(36).substring(2);
    const body = `--${boundary}\r\nContent-Disposition: form-data; name="file"; filename="${testFileName}"\r\nContent-Type: text/plain\r\n\r\n${testContent}\r\n--${boundary}--\r\n`;
    for (const ep of uploadEndpoints) {
      const fullUrl = new URL(ep, baseUrl).href;
      try {
        const resp = await fetch(fullUrl, {
          method: 'POST',
          headers: { 'Content-Type': `multipart/form-data; boundary=${boundary}` },
          body: body,
          credentials: 'omit'
        });
        if (resp.status === 200 || resp.status === 201 || resp.status === 302) {
          const possiblePaths = ['/uploads/', '/upload/', '/files/', '/media/', '/images/'];
          let found = false;
          for (const path of possiblePaths) {
            const testUrl = new URL(path + testFileName, baseUrl).href;
            try {
              const testResp = await fetch(testUrl, { method: 'HEAD', credentials: 'omit' });
              if (testResp.status === 200) {
                results.fileUploads.push({ url: fullUrl, endpoint: ep, status: 'success', fileUrl: testUrl });
                found = true;
                break;
              }
            } catch (_) {}
          }
          if (!found) {
            results.fileUploads.push({ url: fullUrl, endpoint: ep, status: 'upload accepted (file location unknown)' });
          }
        }
      } catch (_) {}
    }
  }

  // ----- Main crawler -----
  async function startScan(startUrl) {
    baseUrl = startUrl;
    baseOrigin = new URL(startUrl).origin;
    visited.clear();
    queue.length = 0;
    Object.keys(results).forEach(k => {
      if (Array.isArray(results[k])) results[k] = [];
      else if (typeof results[k] === 'object') results[k] = {};
    });
    totalPages = 0;
    scannedPages = 0;

    ui.log('🚀 Starting CSP‑aware brute‑force scan...', 'info');
    ui.log(`Base URL: ${baseUrl}`, 'info');

    // Exposed files
    const fileList = [
      '.env', '.git/config', 'backup.zip', 'config.php', 'wp-config.php',
      'robots.txt', 'sitemap.xml', '.htaccess', 'web.config', 'phpinfo.php',
      'backup.sql', 'debug.log', 'error_log', 'access_log', 'logs/access.log',
      'log/access.log', 'tmp/sessions', 'tmp/', 'session.php'
    ];
    for (const f of fileList) {
      const full = new URL(f, baseUrl).href;
      try {
        const resp = await fetchUrl(full, 3000);
        if (resp.status === 200) {
          results.exposed.push({ url: full, file: f, status: 200 });
        }
      } catch (_) {}
    }

    await scanDirectories(baseUrl);
    await scanServerInfo(baseUrl);

    queue.push(baseUrl);
    let active = 0;
    let index = 0;
    const depthMap = new Map();
    depthMap.set(baseUrl, 0);

    while (index < queue.length && results.pages.length < MAX_PAGES) {
      while (active < CONCURRENCY && index < queue.length && results.pages.length < MAX_PAGES) {
        const url = queue[index++];
        if (visited.has(url)) continue;
        const depth = depthMap.get(url) || 0;
        active++;
        scanPage(url, depth).then(() => {
          scannedPages++;
          ui.progressBar.style.width = Math.min(100, (scannedPages / Math.max(1, totalPages)) * 100) + '%';
          ui.scannedCount.textContent = `${scannedPages} / ${totalPages}`;
          ui.statusText.textContent = `Scanning... ${scannedPages} pages`;
        }).catch(err => {
          ui.log(`Error scanning ${url}: ${err.message}`, 'error');
        }).finally(() => {
          active--;
        });
      }
      await new Promise(r => setTimeout(r, 100));
    }

    while (active > 0) {
      await new Promise(r => setTimeout(r, 200));
    }

    // Admin brute and file upload
    const adminUrls = [];
    for (const d of results.dirs) {
      if (/admin|login|wp-admin|administrator/i.test(d.url)) adminUrls.push(d.url);
    }
    for (const p of results.pages) {
      if (/admin|login|wp-admin|administrator/i.test(p.url)) adminUrls.push(p.url);
    }
    if (adminUrls.length > 0) {
      ui.log('Brute‑forcing admin logins...', 'info');
      await bruteForceAdmin(adminUrls);
    }

    ui.log('Testing file upload endpoints...', 'info');
    await testFileUpload(baseUrl);

    ui.statusText.textContent = 'Scan complete!';
    ui.progressBar.style.width = '100%';
    ui.scannedCount.textContent = `${results.pages.length} / ${results.pages.length}`;
    ui.log('✅ Scan finished.', 'pass');
    ui.reportBtn.disabled = false;
    ui.reportBtn.addEventListener('click', generateReport);
  }

