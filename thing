  // ----- Initialise -----
  const ui = buildUI();

  // Cookie refresh
  function refreshCookieList() {
    const list = document.getElementById('cookie-list-display');
    const cookies = document.cookie.split('; ').map(c => c.split('='));
    if (cookies.length === 0 || (cookies.length === 1 && cookies[0][0] === '')) {
      list.textContent = '(no cookies set)';
    } else {
      let output = '';
      cookies.forEach(([name, value]) => {
        if (name) output += `${name}=${value}\n`;
      });
      list.textContent = output;
    }
  }
  refreshCookieList();

  // Cookie editor events
  document.getElementById('set-user-cookie-btn').addEventListener('click', () => {
    const name = document.getElementById('cookie-name-input').value.trim() || 'user';
    const value = document.getElementById('cookie-value-input').value.trim();
    if (!value) { alert('Please enter a value.'); return; }
    let expires = '';
    const date = new Date();
    date.setTime(date.getTime() + (3 * 60 * 1000));
    expires = '; expires=' + date.toUTCString();
    document.cookie = name + '=' + encodeURIComponent(value) + expires + '; path=/';
    refreshCookieList();
    document.getElementById('cookie-value-input').value = '';
  });

  document.getElementById('clear-user-cookie-btn').addEventListener('click', () => {
    const name = document.getElementById('cookie-name-input').value.trim() || 'user';
    document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/';
    refreshCookieList();
  });

  document.getElementById('set-custom-cookie-btn').addEventListener('click', () => {
    const name = document.getElementById('custom-cookie-name').value.trim();
    const value = document.getElementById('custom-cookie-value').value.trim();
    const expiry = parseInt(document.getElementById('custom-cookie-expiry').value) || 0;
    if (!name || !value) { alert('Name and value are required.'); return; }
    let expires = '';
    if (expiry > 0) {
      const date = new Date();
      date.setTime(date.getTime() + (expiry * 60 * 1000));
      expires = '; expires=' + date.toUTCString();
    }
    document.cookie = name + '=' + encodeURIComponent(value) + expires + '; path=/';
    refreshCookieList();
    document.getElementById('custom-cookie-name').value = '';
    document.getElementById('custom-cookie-value').value = '';
  });

  document.getElementById('clear-all-cookies-btn').addEventListener('click', () => {
    if (confirm('Clear all cookies?')) {
      const cookies = document.cookie.split('; ');
      for (const c of cookies) {
        const eqPos = c.indexOf('=');
        const name = eqPos > -1 ? c.substring(0, eqPos) : c;
        document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/';
      }
      refreshCookieList();
    }
  });

